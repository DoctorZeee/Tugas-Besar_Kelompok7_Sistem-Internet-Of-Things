# ==============================================================================
# Smart Warehouse — contoh konfigurasi
# Salin: cp .env.example .env  →  php artisan key:generate  →  isi nilai kosong.
# JANGAN commit file .env. Nilai di bawah hanya contoh aman untuk lokal.
# ==============================================================================

# --- Aplikasi -----------------------------------------------------------------
APP_NAME="Smart Warehouse"
APP_ENV=local                 # production di server
APP_KEY=                      # diisi oleh: php artisan key:generate
APP_DEBUG=true                # WAJIB false di production
APP_URL=http://localhost:8000 # https://domain-anda di production

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Log ----------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # warning di production

# --- Database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_warehouse_web
DB_USERNAME=root              # production: user khusus, bukan root
DB_PASSWORD=

# --- Session, cache, queue ----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false         # true di production
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true  # aktifkan di production (HTTPS)

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Akun awal (dibuat oleh: php artisan db:seed) -----------------------------
# Wajib diisi dengan password kuat; seeder tidak menyediakan password bawaan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
OPERATOR_NAME=Operator
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# --- MQTT broker (Laravel <-> ESP32) ------------------------------------------
# Pakai TLS dan akun broker khusus Laravel (terpisah dari akun ESP32).
MQTT_HOST=
MQTT_PORT=8883
MQTT_CLIENT_ID=               # kosongkan agar dibuat acak
MQTT_CLEAN_SESSION=true
MQTT_ENABLE_LOGGING=false
MQTT_TLS_ENABLED=true
MQTT_TLS_ALLOW_SELF_SIGNED_CERT=false
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
# Isi hanya bila CA broker tidak ada di trust store sistem
# (HiveMQ Cloud: storage/certs/isrg-root-x1.pem, gunakan path absolut).
# MQTT_TLS_CA_FILE=/path/absolut/ke/isrg-root-x1.pem
# MQTT_TLS_CA_PATH=
MQTT_AUTH_USERNAME=
MQTT_AUTH_PASSWORD=           # beri tanda kutip tunggal bila memuat # atau $
MQTT_CONNECT_TIMEOUT=10
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE_INTERVAL=30
MQTT_AUTO_RECONNECT_ENABLED=disable
MQTT_AUTO_RECONNECT_MAX_RECONNECT_ATTEMPTS=3
MQTT_AUTO_RECONNECT_DELAY_BETWEEN_RECONNECT_ATTEMPTS=2

# --- Integrasi lift -----------------------------------------------------------
# Topik wajib sama dengan konstanta MQTT_TOPIC_* di firmware Config.h.
WAREHOUSE_TOPIC_COMMAND=kelompok7/smartwarehouse/lift/command
WAREHOUSE_TOPIC_TELEMETRY=kelompok7/smartwarehouse/lift/telemetry
WAREHOUSE_TOPIC_ADMIN_COMMAND=kelompok7/smartwarehouse/lift/admin/command
WAREHOUSE_TOPIC_ADMIN_RESULT=kelompok7/smartwarehouse/lift/admin/result
WAREHOUSE_LOCK_SECONDS=16
WAREHOUSE_TELEMETRY_MAX_AGE=15
WAREHOUSE_SETTLE_SECONDS=3
WAREHOUSE_REJECT_SECONDS=8

# --- Reverb WebSocket ---------------------------------------------------------
# Lokal: http://127.0.0.1:8080. Production: host/port/skema yang dijangkau browser
# (mis. wss di 443 lewat reverse proxy), dan REVERB_ALLOWED_ORIGINS = domain dashboard.
# Setelah mengubah REVERB_* / VITE_REVERB_*, jalankan ulang npm run build.
REVERB_APP_ID=smart-warehouse-local
REVERB_APP_KEY=               # string acak panjang
REVERB_APP_SECRET=            # string acak panjang
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Mail ---------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
